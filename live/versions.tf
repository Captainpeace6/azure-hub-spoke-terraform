terraform {
  required_version = ">= 1.6.0"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.10"
    }
  }

  # State in an Azure Storage account; pipelines authenticate with
  # Workload Identity Federation (OIDC), so no client secrets are stored.
  backend "azurerm" {
    use_oidc         = true
    use_azuread_auth = true
  }
}

provider "azurerm" {
  features {}
  use_oidc = true
  # subscription_id comes from ARM_SUBSCRIPTION_ID
}
